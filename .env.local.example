# Local MongoDB via Docker (run: docker compose -f docker/docker-compose.yml up -d)
DATABASE_URL="mongodb://admin:password@localhost:27018/home-wealth?authSource=admin"

# Or MongoDB Atlas connection string
# DATABASE_URL="mongodb+srv://USER:PASSWORD@cluster.mongodb.net/home-wealth?appName=Cluster0"

# Auth.js secret — generate with: npx auth secret
AUTH_SECRET=""

# Google OAuth credentials (https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
